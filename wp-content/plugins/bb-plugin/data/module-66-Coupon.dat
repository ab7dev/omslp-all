    const button = document.querySelector("#popup-coupon-button a.fl-button");

    if (button) {
      button.addEventListener("click", function (e) {
        // Stop if Beaver Builder editor is active
        if (document.body.classList.contains("fl-builder-edit")) {
          return; 
        }

        e.preventDefault();

        // Get the coupon code text from <p> inside #popup-coupon-code
        const codeElement = document.querySelector("#popup-coupon-code p");
        const codeToCopy = codeElement ? codeElement.textContent.trim() : "";

        if (codeToCopy) {
          navigator.clipboard.writeText(codeToCopy)
            .then(() => {
              alert("Code copied: " + codeToCopy);
            })
            .catch(err => {
              console.error("Failed to copy: ", err);
            });
        } else {
          alert("No coupon code found!");
        }
      });
    }
